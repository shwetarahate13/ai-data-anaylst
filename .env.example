# ==============================================================================
# Autonomous AI Data Analyst Agent - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your desired settings.
# Leave all API keys empty to run fully OFFLINE (deterministic rules + template narrator).

# LLM Provider: "anthropic", "openai", "ollama", or leave empty to auto-detect from keys
LLM_PROVIDER=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-sonnet-5-5

# --- OpenAI (GPT-4o, GPT-4o-mini) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local Ollama / Open-Source LLMs ---
# If using Ollama, set LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# --- Application Settings ---
ANALYST_CURRENCY=$
